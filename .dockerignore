# Lo que no tiene por que entrar en el contexto de compilacion de la imagen del
# backend, cuyo contexto es esta raiz (ver backend/Dockerfile: el catalogo de
# opciones vive en docs/ y el build lo necesita).
#
# `build/` es el motivo principal: sin estas lineas el contexto lleva los
# artefactos de la compilacion de la maquina de quien construye —con otro JDK y
# otra fecha— y la imagen deja de ser reproducible desde el codigo.
**/build/
**/.gradle/
.git/
.github/

# El frontend se construye con su propia imagen y su propio contexto
# (frontend/Dockerfile). Aqui solo abultaria: node_modules y dist pesan mas que
# todo lo demas junto.
frontend/node_modules/
frontend/**/node_modules/
frontend/**/dist/
frontend/.yarn/
**/.yarn/

# El prototipo de referencia. Es documentacion navegable, no entra en ninguna
# imagen.
design/

# De docs/ solo se copia un archivo, y con nombre propio en el Dockerfile.
despliegue/
