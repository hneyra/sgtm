# Gradle
backend/.gradle/
backend/build/
backend/*/build/
backend/buildSrc/build/
backend/buildSrc/.gradle/
backend/buildSrc/.kotlin/

# IDE
.idea/
*.iml

# Frontend
node_modules
dist/
*.tsbuildinfo

# Playwright: lo que deja una ejecucion, no lo que se versiona
frontend/test-results/
frontend/playwright-report/

# Python (scripts/)
__pycache__/
*.pyc

# Sistema
.DS_Store

.thumbnail

# Despliegue: el archivo de claves de la instalacion. El .env.ejemplo si se
# versiona; el .env con las claves de verdad, nunca.
despliegue/.env

# La superposicion de compose que cada quien usa para desarrollar —publicar el
# puerto de la base, montar un volumen— es de su maquina, no de la instalacion.
# Ver docs/D0-desarrollo/entorno-local.md §2.
despliegue/compose.override.yaml
despliegue/compose.override.yml

# Fuentes normativas binarias (PDF de El Peruano, gpkg del MEF, planos): su copia
# durable es S3 (bucket sgtm-fuentes-normativas), archivada con
# scripts/valores-normativos/archivar_fuente_normativa.sh. En el repo solo va lo
# derivado en texto (CSV) y el README con las URIs y sus sha256.
docs/10-negocio/valores-normativos/fuentes/**/*.pdf
docs/10-negocio/valores-normativos/fuentes/**/*.gpkg

# Worktrees temporales de agentes (harness de Claude Code)
.claude/worktrees/
