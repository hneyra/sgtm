# Copiar a `.env` y poner claves generadas, no estas.
#
#   cd despliegue && cp .env.ejemplo .env
#   sed -i "s/CAMBIAR_.*/$(openssl rand -hex 24)/" .env   # una por linea, no todas iguales
#
# `.env` esta en .gitignore. Si alguna vez aparece en un diff, la clave que lleve
# deja de ser una clave: hay que rotarla, no borrarla del commit.

# Superusuario del motor. Existe solo dentro del contenedor de la base: ni la
# aplicacion ni el migrador lo usan nunca, y el migrador se niega a trabajar con
# un rol que sea superusuario o tenga BYPASSRLS.
SGTM_CLAVE_SUPERUSUARIO=CAMBIAR_superusuario

# El unico rol con DDL. Vive en el contenedor de migracion, que corre y termina.
SGTM_CLAVE_OWNER=CAMBIAR_owner

# El rol de la aplicacion: sin DDL, sin BYPASSRLS, sin DELETE y propietario de
# nada. Es el que lleva el proceso que esta expuesto en HTTP.
SGTM_CLAVE_APP=CAMBIAR_app

# Puerto en el que se publica la aplicacion. 8080 si no se pone.
SGTM_PUERTO=8080
